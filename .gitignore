# ---------------------------------------------------------------------------
# Raw and derived data are NOT tracked. They are large (~780 MB) and are
# rebuilt by notebooks/01_ingest and notebooks/02_dataset. See README.
# ---------------------------------------------------------------------------
dataset/*
!dataset/shared/

# Inside dataset/shared, keep only the small frozen artifacts that define the
# experiment. baseline_windows.csv (7.5 MB) is regenerated by shared_setup.
dataset/shared/baseline_windows.csv

# Model checkpoints, forecast tensors, run outputs
results/
*.npy
*.pt
*.ckpt
*.zip

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# OS
.DS_Store
Thumbs.db
